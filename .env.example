# ─── Database (Supabase → Project Settings → Database → Connection string) ───
# Transaction pooler (port 6543) for the app:
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# Session pooler or direct connection (port 5432) for migrations:
DIRECT_DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-us-west-1.pooler.supabase.com:5432/postgres

# ─── Supabase Auth (Project Settings → API) ───
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# First admin (signs in with Google and becomes admin automatically)
BOOTSTRAP_ADMIN_EMAIL=you@yourfirm.com

# ─── Google OAuth client for Drive + Calendar (Google Cloud → APIs & Services → Credentials) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 64 hex chars. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Public URL of the app (no trailing slash)
APP_URL=https://cph-crm.vercel.app

# Protects /api/cron/gcal-sync (Vercel sends it automatically as a Bearer token)
CRON_SECRET=

# ─── Local development only (ignored on Vercel) ───
# DEV_AUTH_BYPASS=true
# DEV_AUTH_EMAIL=you@yourfirm.com
